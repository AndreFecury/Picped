# Copie este arquivo para .env e ajuste os valores (o .env NÃO vai para o Git).
#   Windows: copy .env.example .env   |   Linux/Mac: cp .env.example .env
#
# DB_HOST: use localhost rodando a API fora do Docker (uvicorn).
#          No docker compose o valor é sobrescrito para "db" automaticamente.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=picped
DB_USER=postgres
DB_PASSWORD=picped

# Porta da API no seu computador (docker compose)
API_PORT=8000

# Pool de conexões (SQLAlchemy)
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
# segundos esperando uma conexão livre do pool
DB_POOL_TIMEOUT=30
# segundos até renovar uma conexão
DB_POOL_RECYCLE=1800
# segundos para desistir de conectar (API responde 503)
DB_CONNECT_TIMEOUT=5

# Banco usado pelos testes (pytest). ATENÇÃO: é apagado e recriado a cada teste,
# então nunca use o mesmo nome do DB_NAME.
TEST_DB_NAME=picped_test

# Autenticação (token do app). Em produção use uma chave longa e aleatória:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=picped-dev-troque-esta-chave
# validade do token de login, em horas
TOKEN_HORAS=72
# origens liberadas para chamadas pelo navegador (separe por vírgula; * = todas)
CORS_ORIGENS=*
